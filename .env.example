# Copy to .env (git-ignored) and edit. With no variables set the project runs exactly as the graded capstone:
# MOCK_LLM=true, no keys, no network. .env is NOT loaded on import; pass it explicitly, for example
#   .venv\Scripts\python.exe -m uvicorn app.api.main:app --env-file .env
# Tests never read it.

# --- Model provider -------------------------------------------------------------------------------------
# MOCK_LLM=true (default) forces the deterministic mock whatever LLM_PROVIDER says.
MOCK_LLM=true
# mock | ollama | openai_compatible
LLM_PROVIDER=mock

# Ollama (local, no key). The /v1 suffix is added automatically.
# 127.0.0.1, not localhost: on Windows, localhost costs ~2 s per new connection (IPv6 tried first).
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Default qwen3:4b-instruct-2507-q4_K_M (measured best on a 6 GB GPU); alternatives: qwen2.5:7b-instruct
# (spills to CPU on 6 GB, about 2.3x slower), qwen2.5:3b-instruct (fastest, least reliable)
LLM_MODEL=

# Any other OpenAI-compatible server (LLM_PROVIDER=openai_compatible): base URL + model, key optional.
# ${NAME} in LLM_BASE_URL is replaced by the variable NAME (keeps an account ID out of the URL line).
LLM_BASE_URL=
LLM_API_KEY=
# Or name the variable that holds the key, so several provider keys can live here side by side:
LLM_API_KEY_ENV=
# Reasoning models only (gpt-oss, Gemini): none | minimal | low | medium | high. Empty: not sent.
LLM_REASONING_EFFORT=

# Hosted free tiers measured in evaluation/V2_HOSTED_PROVIDERS.md (fill in only the keys you use):
#   Groq:        LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=openai/gpt-oss-120b  LLM_API_KEY_ENV=GROQ_API_KEY
#   Cloudflare:  LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/${CLOUDFLARE_ACCOUNT_ID}/ai/v1
#                LLM_MODEL=@cf/openai/gpt-oss-120b  LLM_API_KEY_ENV=CLOUDFLARE_API_TOKEN
#   Gemini:      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                LLM_MODEL=gemini-3-flash-preview  LLM_API_KEY_ENV=GEMINI_API_KEY
#   with LLM_REASONING_EFFORT=low for all three.
GROQ_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
GEMINI_API_KEY=

# Generation controls (defaults shown; leave LLM_MAX_RETRIES empty for the provider default:
# 0 for ollama, so a stopped or overloaded local server fails fast instead of multiplying the wait; 2 otherwise)
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=
LLM_MAX_TOKENS=1024

# --- Database (optional) ---------------------------------------------------------------------------------
# Unset: orders and chat history stay in memory (the capstone behaviour). Set: PostgreSQL for orders, chat history
# and the request log. Create the schema with `alembic upgrade head`, then `python -m scripts.seed_db`.
DATABASE_URL=
# Only for tests_v2/test_v2_postgres.py, which DROPS and recreates the schema: never point it at real data.
TEST_DATABASE_URL=

# --- Docker Compose (docker compose up) -----------------------------------------------------------------
# Required by docker-compose.yml: the password of the compose Postgres (letters and digits only). Compose builds
# the api's DATABASE_URL from it, so DATABASE_URL above is ignored inside compose.
POSTGRES_PASSWORD=changeme
# Where the api CONTAINER finds Ollama. Default (empty): the host's Ollama via host.docker.internal.
# With `docker compose --profile ollama up`: http://ollama:11434
DOCKER_OLLAMA_BASE_URL=

# --- Public demo protection -----------------------------------------------------------------------------
# Questions per client IP (POST /ask and each WebSocket question); 0 or empty = off. Off by default locally; the
# Docker image sets 6 per minute and 100 per UTC day.
RATE_LIMIT_PER_MINUTE=
RATE_LIMIT_PER_DAY=

# --- Evaluation judge ------------------------------------------------------------------------------------
# mock (default: the deterministic rubric scorer) | llm (the configured real model; label results as a real LLM judge)
JUDGE_PROVIDER=mock
