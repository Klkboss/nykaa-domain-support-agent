# Copy to .env (git-ignored) and edit. With no variables set the project runs exactly as the graded capstone:
# MOCK_LLM=true, no keys, no network. .env is NOT loaded on import; pass it explicitly, for example
#   .venv\Scripts\python.exe -m uvicorn app.api.main:app --env-file .env
# Tests never read it.

# --- Model provider -------------------------------------------------------------------------------------
# MOCK_LLM=true (default) forces the deterministic mock whatever LLM_PROVIDER says.
MOCK_LLM=true
# mock | ollama | openai_compatible
LLM_PROVIDER=mock

# Ollama (local, no key). The /v1 suffix is added automatically.
OLLAMA_BASE_URL=http://localhost:11434
# Default qwen2.5:7b-instruct; faster fallback on a 6 GB GPU: qwen2.5:3b-instruct
LLM_MODEL=

# Any other OpenAI-compatible server (LLM_PROVIDER=openai_compatible): base URL + model, key optional.
LLM_BASE_URL=
LLM_API_KEY=

# Generation controls (defaults shown)
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=1024
